{
  "name": "znk-app",
  "version": "1.0.0",
  "description": "ZNK - Système de gestion intelligent avec authentification",
  "main": "main.js",
  "author": "ZNK ZazaNoah",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --x64",
    "analyze-size": "node scripts/diagnose-size.js",
    "postinstall": "node scripts/setup_ffmpeg_script.js"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "asar": true,
    "compression": "maximum",
    "appId": "com.znk.app",
    "productName": "ZNK",
    "copyright": "Copyright © 2025 ZNK",
    "directories": {
      "output": "/Volumes/ZNKfly/ZNK_Builds",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!**/*.log",
      "!.git*",
      "!.gitignore",
      "!.env*",
      "!.DS_Store",
      "!ZNKadminDash.html",
      "!modules-admin/**/*",
      "!scripts/**/*",
      "!dist/**/*",
      "!builds/**/*",
      "!*.sh",
      "!*.backup",
      "!test-*.js",
      "!node_modules/.cache/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/README*",
      "!node_modules/**/.bin/**/*",
      "!node_modules/**/docs/**/*",
      "!node_modules/**/examples/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/*.d.ts",
      "!converted-videos/**/*",
      "!znkAudio/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "bin/**/*",
      "node_modules/**/*.node"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  },
  "dependencies": {
    "fs-extra": "^11.3.3",
    "chokidar": "^3.5.3",
    "mammoth": "^1.6.0",
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "cors": "^2.8.5",
    "pdfkit": "^0.13.0",
    "three": "^0.158.0",
    "electron-store": "^8.1.0",
    "fluent-ffmpeg": "^2.1.2"
  }
}